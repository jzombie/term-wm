# Template for PERSONAL cargo configuration. Copy the parts you need into
# one of:
#   - ~/.cargo/config.toml                     (global, all projects)
#   - <ancestor-of-repo>/.cargo/config.toml    (machine-local, this project)
#
# The committed `.cargo/config.toml` in this repository is toolchain POLICY
# (it injects TERM_WM_NAMESPACE=term-wm-dev so cargo-driven executions stay
# off the shared system gateway). Keep personal state out of it.

# Local path patches for muxio/vt100 development (adjust paths for your
# machine; relative paths resolve against this file's directory).
[patch.crates-io]
muxio-core = { path = "../rust-muxio/core" }
muxio-rpc-service = { path = "../rust-muxio/extensions/muxio-rpc-service" }
muxio-rpc-service-caller = { path = "../rust-muxio/extensions/muxio-rpc-service-caller" }
muxio-rpc-service-endpoint = { path = "../rust-muxio/extensions/muxio-rpc-service-endpoint" }
muxio-tokio-rpc-ipc-client = { path = "../rust-muxio/extensions/muxio-tokio-rpc-ipc-client" }
muxio-tokio-rpc-ipc-server = { path = "../rust-muxio/extensions/muxio-tokio-rpc-ipc-server" }
muxio-tokio-mpsc-adapter = { path = "../rust-muxio/extensions/muxio-tokio-mpsc-adapter" }
term-wm-vt100 = { path = "../term-wm-vt100" }
