# Playground copy flow: producer -> transform -> `--util copy` consumer,
# all routed through internal WITH_IO pipes (no host shell pipes).
# Run via the "ox: playground copy diff" task, or directly:
#   term-wm --util oxdock scripts/playground_copy.oxfile
# Tweak the middle step, then check the paste buffer.
# NOTE: the consumer lines are platform-guarded because RUN executes through
# the platform shell, so the env-var reference spelling differs per platform.
INHERIT_ENV [TERM_WM_EXE, TERM_WM_PID]
WORKSPACE LOCAL

# Diff against main branch
LET $body = RUN git diff main

# Apply template around `git diff` body
WITH_IO [stdout=pipe:out] EXPAND .term-wm/.oxdock/code_reviewer.template CODE_PLAN=$body

WITH_IO [stdin=pipe:out] RUN ["{{ env:TERM_WM_EXE }}", "--util", "copy", "--", "--force-osc52"]
