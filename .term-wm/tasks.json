// Project Tasks — `.term-wm/tasks.json` (JSONC: `//` and `/* */` comments allowed)
// See `docs/tasks.md` for full schema.
//
// `command` is tokenized via `shell-words` (POSIX shell word splitting, respecting
// quotes and escapes). You can put the full invocation in one string — no separate
// `args` array needed:
//
//   { "label": "dev: Run", "command": "cargo run" }
//   { "label": "dev: Help", "command": "cargo run -- --help" }
//   { "label": "quoted",  "command": "echo 'hello world'" }
//
// Equivalent split form (also supported — `args` are appended after `command` tokens):
//
//   { "label": "dev: Run", "command": "cargo", "args": ["run"] }
//
// Other optional fields: `cwd` (string, absolute or relative to project root),
// `env` (object), `environments` (e.g. ["dev"] / ["prod"] / ["test"]),
// `platforms` (e.g. ["linux", "macos"], with "darwin" as an alias for "macos").
// Placeholders: `{wm.pid}` (spawning process PID) and `{wm.exe}` (term-wm
// executable path). Inside shell scripts prefer the env-var indirection shown
// below (`env` entry + `$VAR`) so paths containing spaces or quotes stay safe.
[
    {
        "label": "dev: cargo pkg --help",
        "command": "cargo run -- --help",
        "environments": ["dev"]
    },
    {
        "label": "dev: cargo udeps",
        "command": "cargo udeps --workspace --all-targets --all-features",
        "environments": ["dev"]
    },
    {
        "label": "dev: cargo clippy",
        "command": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
        "environments": ["dev"]
    },
    {
        "label": "dev: cargo fmt",
        "command": "cargo fmt --all",
        "environments": ["dev"]
    },
    {
        "label": "dev: cargo test all features",
        "command": "cargo test --workspace --all-features",
        "environments": ["dev"]
    },
    {
        "label": "dev: Copy Git Diff",
        "command": "sh",
        "args": ["-c", "git diff | \"$TERM_WM_EXE\" --util copy"],
        "env": { "TERM_WM_EXE": "{wm.exe}" },
        "environments": ["dev"],
        "platforms": ["linux", "macos"]
    },
    {
        "label": "dev: Copy Git Diff",
        "command": "powershell",
        "args": ["-NoProfile", "-Command", "git diff | & $env:TERM_WM_EXE --util copy"],
        "env": { "TERM_WM_EXE": "{wm.exe}" },
        "environments": ["dev"],
        "platforms": ["windows"]
    }
]
